# RouterGuardian configuration.
#
# Copy this file to  backend/.env  and fill in the blanks. Everything here is
# optional: with no .env at all the app still runs, alerts are rendered and
# stored in the outbox without being transmitted, and the assistant answers
# offline. Real environment variables always override this file.
#
# backend/.env is git-ignored. Never commit real credentials.

# ---------------------------------------------------------------- email
# Gmail requires an APP PASSWORD, not your account password. Google removed
# "less secure app" access in May 2025, so the normal password is rejected.
#   1. Enable 2-Step Verification on the account.
#   2. Google Account -> Security -> App passwords -> generate one for "Mail".
#   3. Paste the 16-character code below, spaces removed.
ROUTERGUARDIAN_SMTP_HOST=smtp.gmail.com
ROUTERGUARDIAN_SMTP_PORT=587
ROUTERGUARDIAN_SMTP_TLS=true
ROUTERGUARDIAN_SMTP_USER=
ROUTERGUARDIAN_SMTP_PASSWORD=

# Must match the authenticated account: Gmail rejects a From it does not own.
ROUTERGUARDIAN_ALERT_FROM=
# Comma-separated. Everyone here receives every alert.
ROUTERGUARDIAN_ALERT_TO=

# Minimum gap between two alerts for the same router.
ROUTERGUARDIAN_ALERT_COOLDOWN_MINUTES=60
# false keeps the outbox to hardware alerts only.
ROUTERGUARDIAN_NOTIFY_SOFTWARE=true

# Where the app is reachable from a mail client. Every alert links back to its
# own troubleshooting conversation, so this has to be an address the recipient
# can actually open.
ROUTERGUARDIAN_PUBLIC_URL=http://localhost:8000

# ------------------------------------------------------------ assistant
# Set this and the assistant's replies are written by a language model, still
# grounded in the stored incident. Leave it empty and it answers offline.
# Get a key at https://console.anthropic.com -> API keys.
ANTHROPIC_API_KEY=
ROUTERGUARDIAN_LLM_MODEL=claude-sonnet-5
